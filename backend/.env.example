# -----------------------------------------------------------------------------
# TDM – Terrorism Detection & Monitoring System
# Copy this file to .env and fill in the real values.
# -----------------------------------------------------------------------------

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (JSON list of allowed front-end origins) ---
ALLOWED_HOSTS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- MongoDB Atlas ---
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tdm_db

# --- JWT / Auth ---
# Generate a strong secret with:   openssl rand -hex 32
SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- File uploads ---
MAX_FILE_SIZE=52428800
UPLOAD_DIR=data/uploads

# --- ML model (HuggingFace pretrained) ---
# Any HuggingFace text-classification model. Defaults to a toxicity classifier,
# the closest public proxy for extremist-content detection that does not
# require custom training. Other good options:
#   - "Hate-speech-CNERG/dehatebert-mono-english"
#   - "cardiffnlp/twitter-roberta-base-hate"
HF_MODEL_NAME=GroNLP/hateBERT
HF_MODEL_CACHE=data/models
ML_DEVICE=cpu
ML_MAX_CHARS=4000

# --- Reddit API ---
# Create an app at https://www.reddit.com/prefs/apps  (type: "script")
# - client_id  = the short string directly under the app name
# - client_secret = the longer "secret" field
# Leave blank to disable the Reddit collector.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TDM-Research-Bot/1.0 (by u/your_username)
REDDIT_DEFAULT_SUBREDDITS=news,worldnews,CredibleDefense

# --- RSS + Telegram bridge ---
# RSSHub is used to pull public Telegram channels as RSS feeds. For production
# use, self-host RSSHub: https://docs.rsshub.app/install/
TELEGRAM_RSS_BRIDGE=https://rsshub.app/telegram/channel/

# --- Monitoring cadence / thresholds ---
COLLECTOR_INTERVAL_SECONDS=300
ALERT_THRESHOLD=0.6
