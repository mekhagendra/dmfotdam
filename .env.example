# Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to git — it contains secrets

# ============================================================================
# Application Settings
# ============================================================================

DEBUG=false
# Set to true for verbose logging and debug panels in sidebar

# ============================================================================
# Database Configuration (Optional)
# ============================================================================

MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/tdm
# MongoDB Atlas connection string
# Format: mongodb+srv://username:password@host/dbname

# ============================================================================
# API Configuration (Optional)
# ============================================================================

API_BASE_URL=http://localhost:8080
# Backend API base URL (if running FastAPI separately)
# Local: http://localhost:8080
# Cloud: https://your-api-url.herokuapp.com

# ============================================================================
# User Configuration (Optional)
# ============================================================================

SEED_ADMIN_USER=admin
# Default admin username for first login
